{
  "manifest_version": 3,
  "name": "JobTrack: save jobs",
  "short_name": "JobTrack",
  "version": "1.1.0",
  "description": "Save the job posting you are looking at to your JobTrack board, and track LinkedIn and Indeed applications automatically.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to JobTrack",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://smart-job-tracker-peach.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/*/jobs/*"
      ],
      "js": [
        "content-common.js",
        "content-linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://smartapply.indeed.com/*",
        "https://*.indeed.com/viewjob*",
        "https://*.indeed.com/jobs*"
      ],
      "js": [
        "content-common.js",
        "content-indeed.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
