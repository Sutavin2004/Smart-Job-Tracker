# ── Database (PostgreSQL required — SQLite is no longer supported) ────────────
#
# The app uses PostgreSQL in all environments (local dev + Vercel production).
# On Vercel, the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED automatically.
# For local dev, get a FREE PostgreSQL database in 60 seconds:
#
#   Option A — Neon (recommended): https://neon.tech
#     1. Sign up → create project → copy the connection string
#     2. Neon gives you TWO URLs: a pooled URL and a direct URL.
#        Set DATABASE_URL  = pooled connection string  (postgres://...@-pooler....)
#        Set DATABASE_URL_UNPOOLED = direct connection string  (postgres://...@ep-...)
#
#   Option B — Supabase: https://supabase.com → new project → Settings → Database
#     Set DATABASE_URL and DATABASE_URL_UNPOOLED to the same connection string
#
# After setting DATABASE_URL, run once to create all tables:
#   npx prisma migrate deploy
#
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# ── Anthropic AI ──────────────────────────────────────────────────────────────
# Powers: job discovery agent, cover letters, resume analysis, interview prep
# Get your key → https://console.anthropic.com/settings/keys
# Without this key the app still works — AI endpoints return a 503 gracefully.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Job Board APIs (optional — add for real live job listings) ─────────────────

# JSearch via RapidAPI — scrapes LinkedIn, Indeed & Glassdoor (500 free req/month)
# Sign up: https://rapidapi.com → search "JSearch" → Subscribe to free plan
RAPIDAPI_KEY=""

# Adzuna — free public job board API (10,000 req/month on free plan)
# Sign up: https://developer.adzuna.com → Register → Create App
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# RemoteOK is always active — no key needed (remote jobs only)

# ── Accounts and limits ───────────────────────────────────────────────────────
# Anyone can sign up. These cap how much each account can use per day (UTC),
# so a public sign-up can't run up your Anthropic bill. Defaults shown.
# DAILY_AI_LIMIT="40"         # cover letters, résumé tools, interview prep, etc.
# DAILY_AGENT_LIMIT="6"       # job agent runs, manual and scheduled
# SIGNUP_LIMIT_PER_HOUR="5"   # new accounts per IP address

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Password reset, email confirmation and the daily job digest. Off when unset.
# Free at resend.com. Until you verify a domain there, the default sender can
# only deliver to the email address of your own Resend account.
RESEND_API_KEY=""
# EMAIL_FROM="JobTrack <jobs@yourdomain.com>"
# APP_URL="https://your-site.vercel.app"   # used in email links; defaults to the Vercel production URL

# ── Google sign-in ───────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://<your-site>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Application tracking by email (Resend receiving) ─────────────────────────
# Your Resend receiving domain (Resend → Emails → Receiving), e.g. abc123.resend.app,
# and the signing secret of a webhook pointing at https://<your-site>/api/inbound/resend
# for the "email.received" event.
INBOUND_DOMAIN=""
RESEND_WEBHOOK_SECRET=""
